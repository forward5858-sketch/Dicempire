{
  "name": "dicempire",
  "version": "1.0.0",
  "private": true,
  "description": "Dicempire: arkadaşlarınla, herkes kendi telefonundan oynadığı zar ve ada savaşı",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:app": "node scripts/build-app.js",
    "sync": "npm run build:app && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3"
  }
}
